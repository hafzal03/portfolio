# Copy this file to .env.local for local development. Never commit the real
# values — .env* is gitignored (except this example file).

# Required for the AI chatbot (Gemini embeddings for RAG retrieval + Gemini
# generation). Server-side only — never referenced from client code, so it is
# never bundled into the browser. Without it the site still works fully; the
# chatbot returns a graceful "not configured" message instead of an error.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — used for SEO metadata (Open Graph/canonical URL). Defaults to
# https://hafzal.dev if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
