# Copy this file to .env.local for local development. Never commit the real
# values — .env* is already gitignored.

# Required for the AI chatbot (RAG retrieval + chat completion). Without this,
# the site still works fully; the chatbot returns a graceful "not configured"
# message instead of a raw error.
OPENAI_API_KEY=

# Optional — used for SEO metadata (Open Graph/canonical URL). Defaults to
# https://hafzal.dev if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
